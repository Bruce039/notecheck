{
  "name": "notecheck-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "smoke:extra": "node scripts/smoke-extra.mjs",
    "brand": "node brand/render.mjs",
    "pkg:build": "cd packages/notecheck && npm run build",
    "pkg:test": "cd packages/notecheck && npm test",
    "pkg:pack": "cd packages/notecheck && npm pack --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@miden-sdk/miden-sdk": "0.17.3",
    "@miden-sdk/miden-wallet-adapter-base": "0.17.3",
    "@miden-sdk/miden-wallet-adapter-miden": "0.17.3",
    "@miden-sdk/miden-wallet-adapter-react": "0.17.3",
    "@miden-sdk/react": "0.17.3",
    "qrcode-generator": "2.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@miden-sdk/vite-plugin": "0.17.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^28.1.0",
    "playwright-core": "1.55.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
